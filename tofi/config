# Fonts
font = Iosevka Nerd Font
font-size = 14

# Window
width = 100%
height = 100%
background-color = #272c30
outline-width = 0
border-width = 0
padding-left = 35%
padding-top = 35%

# Text colors
text-color = #cfb9a8
prompt-text = "run: "
prompt-color = #c79e84
placeholder-text = ""
selection-color = #cfb9a8
selection-background = #383a3c
selection-background-padding = 4

# Input
input-color = #cfb9a8
default-result-color = #6e6762

# Results
num-results = 8
result-spacing = 20

# Behavior
hide-cursor = true
history = true
fuzzy-match = true
