# Fonts
font = Iosevka Nerd Font
font-size = 14

# Window
width = 100%
height = 100%
outline-width = 0
border-width = 0
padding-left = 35%
padding-top = 35%

# Text
prompt-text = "run: "
placeholder-text = ""
selection-background-padding = 4

# Colors (symlink switched by scripts/theme)
include = colors

# Results
num-results = 8
result-spacing = 20

# Behavior
hide-cursor = true
history = true
fuzzy-match = true
