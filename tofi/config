# Fonts
font = Iosevka Nerd Font
font-size = 14

# Window
width = 100%
height = 100%
background-color = #101113
outline-width = 0
border-width = 0
padding-left = 35%
padding-top = 35%

# Text colors
text-color = #9f9e99
prompt-text = "run: "
prompt-color = #ac7f7b
placeholder-text = ""
selection-color = #9f9e99
selection-background = #161719
selection-background-padding = 4

# Input
input-color = #9f9e99
default-result-color = #554a62

# Results
num-results = 8
result-spacing = 20

# Behavior
hide-cursor = true
history = true
fuzzy-match = true
