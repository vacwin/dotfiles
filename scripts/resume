#!/bin/bash
sleep 1
hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })'
lid_state=$(cat /proc/acpi/button/lid/LID0/state 2>/dev/null || cat /proc/acpi/button/lid/LID/state 2>/dev/null)
if echo "$lid_state" | grep -q "open"; then
    hyprctl eval 'hl.monitor({ output = "eDP-1", mode = "1920x1080@59.98", position = "0x0", scale = 1 })'
fi
